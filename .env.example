# ==============================================================================
# Mechatronics Academy Yemen - Environment Variables for Vercel Deployment
# ==============================================================================

# 1. Neon PostgreSQL Database Connection String (REQUIRED for production on Vercel)
# Obtain this from your Neon Console (https://console.neon.tech) -> Connection Details -> Connection String (Pooled)
# Example format: postgresql://username:password@ep-cool-fog-123456-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# 2. JWT Secret Key (REQUIRED for production authentication)
# Generate a strong 32+ character random string to sign student and admin session tokens
JWT_SECRET=""

# 3. AI Engine Configuration (Server-Side Only - NEVER exposed to frontend)
# Supports OpenAI API as requested, with fallback to Gemini or local engineering engine
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Optional Gemini AI fallback API key
GEMINI_API_KEY=""

# 4. Admin Dashboard Password
# Initial password for platform owner / administrator (defaults to A7820600 if empty)
ADMIN_PASSWORD=""

# 5. WhatsApp Support Phone Number
# Academy official contact number (e.g. 785500075)
WHATSAPP_NUMBER="785500075"

# 6. Environment Mode (automatically set to "production" by Vercel)
NODE_ENV="production"
